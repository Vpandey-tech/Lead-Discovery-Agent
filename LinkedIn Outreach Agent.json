    {
      "parameters": {
        "promptType": "define",
        "text": "You are B2B Cold Outreach Specialist for Technewity Labs.\nTechnewity Labs provides:\n1. Custom Website Development & Web Applications\n2. AI Solutions & Custom AI Agents\n3. Workflow & Business Process Automation\n\nDraft a short, highly personalized, professional cold outreach email for this prospect.\n--- LEAD INFO ---\nName: {{ $json.name }}\nDesignation/Title: {{ $json.designation }}\nCompany: {{ $json.company }}\nCountry: {{ $json.country }}\n\nReturn STRICT JSON ONLY in this exact structure:\n{\n  \"subject\": \"Quick question regarding {{ $json.company }}'s web & AI stack\",\n  \"body\": \"Hi {{ $json.name }},\n\nI noticed your work as {{ $json.designation }} at {{ $json.company }}.\n\nAt Technewity Labs, we help companies build modern, high-converting websites and custom AI automation workflows to streamline operations.\n\nWould you be open to a quick 10-minute chat next week to see how we could support {{ $json.company }}?\n\nBest regards,\nTechnewity Team\"\n}",
        "options": {
          "systemMessage": "You are a professional B2B outreach specialist for Technewity Labs (Website Development & AI Solutions). Always return valid JSON only."
        }
      },
      "id": "a5111cbf-56d9-498f-ab55-1fe1498c6cd3",
      "name": "Email Agent - Draft Message",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        736,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "// AI Agent ke output se JSON safely parse karo\nconst raw = $json.output || $json.text || '';\nlet parsed = { subject: 'Quick intro', body: raw };\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  // fallback: raw text hi body ban jayega\n}\nreturn [{ json: { ...$('Loop Over Leads (Outreach)').item.json, emailSubject: parsed.subject, emailBody: parsed.body } }];"
      },
