    {
      "parameters": {
        "jsCode": "// Apify se aaya raw data leke required leadsCount tak leads ko structured format mein convert karo\nconst leadsCount = $('Structure Query').first().json.leadsCount;\nconst country = $('Structure Query').first().json.country;\nconst position = $('Structure Query').first().json.position;\n\nconst rawItems = items.map(i => i.json).slice(0, leadsCount);\n\nreturn rawItems.map(profile => ({\n  json: {\n    name: profile.fullName || profile.name || '',\n    designation: profile.headline || position,\n    company: profile.companyName || profile.company || '',\n    location: profile.location || country,\n    profileUrl: profile.profileUrl || profile.url || '',\n    email: profile.email || '',\n    phone: profile.phone || '',\n    country: country,\n    status: 'New',\n    addedAt: new Date().toISOString()\n  }\n}));"
      },
